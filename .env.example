# All values below are server-only. Never put secrets in frontend/config.js.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_public_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Connect database URI, using the database password (not the API secret).
SUPABASE_DB_URL=
DATA_BACKEND=supabase
PUBLIC_LAUNCH_MODE=waitlist

YOUTUBE_API_KEY=
GEMINI_API_KEY=
PREVIEW_DAILY_AI_REQUEST_BUDGET=20
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PRICING_JSON=

APP_ENV=development
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Stable private value for trial-identity signing; Supabase owns login sessions.
JWT_SECRET=change-this-in-production-to-a-long-random-secret
ADMIN_EMAILS=
OPERATOR_NAME=
SUPPORT_EMAIL=
JOB_EXECUTION_MODE=queued
MAX_ACTIVE_JOBS=2
ENABLE_LEAD_ALERTS=false
DAILY_SEARCH_BUDGET=90
DAILY_QUOTA_BUDGET=9000
PAID_DAILY_SEARCH_BUDGET=75
TRIAL_DAILY_SEARCH_BUDGET=10
PREVIEW_DAILY_SEARCH_BUDGET=5
FREE_QUOTA_SHARE=0.6

# Later phases: keep disabled until approval/cost/payment setup is complete.
YOUTUBE_USE_CASE_APPROVED=false
PRICING_UNIT_ECONOMICS_VERIFIED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
